{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api/router?path=:path"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/meetday",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}