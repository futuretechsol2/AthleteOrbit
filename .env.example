# ---- Browser (safe to expose) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Your live site address (used in sign-up / reset emails)
VITE_APP_URL=https://your-app.vercel.app
# Only for the App Store / Play Store build: full address of your live site
VITE_API_BASE=

# ---- Server only (never put these in the app) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key     # same as VITE_SUPABASE_ANON_KEY; used for username log-in
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Parent plans (AthleteOrbit Pro): $15.99/month, $42.99/3 months, $79.99/6 months, $129/year
# Family plans: 3 products (Basic, Plus, Pro) x 4 recurring prices each
STRIPE_PRICE_BASIC_MONTHLY=price_...      # $9.99 / month
STRIPE_PRICE_BASIC_QUARTERLY=price_...    # $26.99 / 3 months
STRIPE_PRICE_BASIC_SEMIANNUAL=price_...   # $49.99 / 6 months
STRIPE_PRICE_BASIC_YEARLY=price_...       # $79 / year
STRIPE_PRICE_PLUS_MONTHLY=price_...       # $15.99 / month   (old STRIPE_PRICE_PARENT_* still work for Plus)
STRIPE_PRICE_PLUS_QUARTERLY=price_...     # $42.99 / 3 months
STRIPE_PRICE_PLUS_SEMIANNUAL=price_...    # $79.99 / 6 months
STRIPE_PRICE_PLUS_YEARLY=price_...        # $129 / year
STRIPE_PRICE_PRO_MONTHLY=price_...        # $24.99 / month
STRIPE_PRICE_PRO_QUARTERLY=price_...      # $66.99 / 3 months
STRIPE_PRICE_PRO_SEMIANNUAL=price_...     # $124.99 / 6 months
STRIPE_PRICE_PRO_YEARLY=price_...         # $199 / year
# Gym plans (AthleteOrbit for Gyms): $99/month, $269/3 months, $499/6 months, $899/year
STRIPE_PRICE_GYM_MONTHLY=price_...
STRIPE_PRICE_GYM_QUARTERLY=price_...
STRIPE_PRICE_GYM_SEMIANNUAL=price_...
STRIPE_PRICE_GYM_YEARLY=price_...
APP_URL=https://your-app.vercel.app

# ---- v2: reminders, travel, gym plans, support ----
CRON_SECRET=any-long-random-string          # Vercel sends it to the daily reminder job
LINK_SECRET=another-long-random-string      # signs unsubscribe links
APP_TIMEZONE=America/New_York
SENDGRID_API_KEY=SG....
EMAIL_FROM=hello@yourdomain.com             # a sender verified in SendGrid
EMAIL_FROM_NAME=AthleteOrbit
BUSINESS_NAME=Your Company LLC
BUSINESS_ADDRESS=Street, City, State ZIP    # required in reminder emails by US law (CAN-SPAM)
SUPPORT_INBOX_EMAIL=futuretechsol2@gmail.com      # where Contact-us questions go
ADMIN_EMAILS=you@yourdomain.com             # these accounts see the Team inbox in the app
CLUB_SEATS=50
# Texts: leave off until Twilio approves your A2P 10DLC registration
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Travel affiliate IDs (optional; links work without them)
BOOKING_AID=
VITE_BOOKING_AID=
# Optional: paste link templates from any affiliate program. Placeholders: {origin} {dest} {depart} {return} {adults} {children} {aid}
TRAVEL_HOTELS_URL=
VITE_TRAVEL_HOTELS_URL=
TRAVEL_FLIGHTS_URL=
VITE_TRAVEL_FLIGHTS_URL=

# ---- v3: sports news ----
# Optional. Defaults to USA Gymnastics' official news feed. Add feeds per sport as JSON, e.g.
# NEWS_FEEDS={"Gymnastics":[{"name":"USA Gymnastics","url":"https://usagym.org/feed/"}],"Swimming":[{"name":"Your swim club","url":"https://example.org/feed/"}]}
NEWS_FEEDS=

# ---- AI provider: Claude (default) or ChatGPT ----
AI_PROVIDER=anthropic                       # anthropic | openai
# ANTHROPIC_API_KEY=...                     # (above) for Claude
OPENAI_API_KEY=                             # for ChatGPT, if AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o

# ---- Online scores ----
# Results sites the app may read (results link pasted by the parent / saved on a meet). Default below.
SCORE_SOURCE_HOSTS=meetscoresonline.com,scorecatonline.com,myusagym.com

# ---- Growth ----
STRIPE_REFERRAL_COUPON=                     # Stripe coupon id: 100% off, duration once (= first month free for invited families)
SINGLE_SESSION=on                           # "off" allows several devices per account
